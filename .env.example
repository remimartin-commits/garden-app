# Coding (Vibe studio): Code Llama 7B via Ollama — match `ollama list`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
CHAT_MODEL=codellama:7b
# RAG chat (/chat tab): different model — match `ollama list`; omit to reuse CHAT_MODEL
RAG_CHAT_MODEL=dolphin3:latest

# Optional: OpenAI API key for RAG embeddings only (leave blank for chat-only)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=./.chroma
DOCS_DIR=./data/docs
RAG_TOP_K=6
# Widen retrieval then dedupe (see app/rag.py)
RAG_FETCH_MULTIPLIER=2
RAG_MAX_CONTEXT_CHARS=12000
# tokens | markdown — markdown splits on # headings before token windows
RAG_CHUNK_STRATEGY=tokens
# Set true after editing files under DOCS_DIR to refresh embeddings
FORCE_REINGEST=false

# --- local_codellama.py (Hugging Face Transformers, optional) ---
# HF_CODELLAMA_MODEL=codellama/CodeLlama-7b-Instruct-hf
# HF_TOKEN=
# HF_DEVICE=auto
# HF_OFFLINE=0
# LOAD_IN_8BIT=0
# MAX_NEW_TOKENS=512
# TEMPERATURE=0.2
# TOP_P=0.95
# SYSTEM_PROMPT=

# --- Offline sync + saved style (main FastAPI app) ---
# USER_DATA_DIR=./data/user
# SYNC_PROBE_URL=https://huggingface.co
# SYNC_PROBE_TIMEOUT_SECONDS=3
# Optional: POST JSON backups when online; queued when offline
# SYNC_BACKUP_URL=
# SYNC_BACKUP_TOKEN=

# --- Autonomous Cursor CLI loop ---
# Leave blank to auto-detect: cursor-agent first, then `cursor agent`
# CURSOR_CLI_COMMAND=cursor agent
# PROJECT_ROOT=.
#
# --- Pool marketing demo (FastAPI) ---
# HTTP API: which routers to mount — pool | all (default all).
# CODEBOT_SITE_VERTICAL=all
# Autonomous agent: pool = focus prompts on app/pool; generic = no vertical guardrails.
# AUTONOMOUS_WORKSPACE_DOMAIN=generic
# Route patch_executor / autonomous openai runner to local CPU (Ollama OpenAI-compatible API):
# OPENAI_CHAT_BASE_URL=http://localhost:11434/v1
# OPENAI_CHAT_MODEL=codellama:latest
# OPENAI_CHAT_API_KEY=ollama
# Chat HTTP timeout (seconds) for patch_executor / openai runner — avoids infinite hang on Ollama.
# OPENAI_CHAT_REQUEST_TIMEOUT_SECONDS=1200
# Feature schema (/autonomy/start topic): OpenAI draft+finalize (default gpt-5.5 on official API unless overridden) → Claude Opus audit.
# FEATURE_SCHEMA_OPENAI_MODEL=gpt-5.5
# FEATURE_SCHEMA_OPENAI_BASE_URL=
# FEATURE_SCHEMA_OPENAI_API_KEY=
# FEATURE_SCHEMA_AUDIT_ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_API_KEY=   # optional; also: CLAUDE_API_KEY, ANTHROPIC_AUTH_TOKEN, FEATURE_SCHEMA_ANTHROPIC_API_KEY
# AUTONOMOUS_RUNNER=auto  # auto | cursor | openai | patch_executor
# AUTONOMOUS_FALLBACK_TO_OPENAI=true
# AUTONOMOUS_AUTO_FIX_BLOCKED=true
# AUTONOMOUS_AUTO_FIX_MAX_ATTEMPTS=3
# AUTONOMOUS_FORCE_ADVANCE_ATTEMPTS=4
# AUTONOMOUS_PARALLEL_WORKERS=4
# AUTONOMOUS_FULL_VERIFICATION_EVERY=5
# AUTONOMOUS_PROTECTED_PATHS=app/main.py,app/autonomy_api.py,app/autonomous_loop.py,app/quote_enquiries.py,app/patch_executor.py,app/entities.py
# AUTONOMOUS_ISOLATE_RUNS=true
# AUTONOMOUS_RUNS_DIR=./outputs
# AUTONOMOUS_CLEANUP_RUNS_ON_START=true
# AUTONOMOUS_RUN_RETENTION=5
# AUTONOMOUS_MAX_ITERATIONS=10
# CURSOR_RUN_TIMEOUT_SECONDS=600
# Wall-clock with no state save before status poll treats patch_executor as stuck (slow LLM: raise this).
# PATCH_EXECUTOR_STALE_STEP_SECONDS=3600

# --- Job / recurring photo attachments (Hetzner Object Storage, S3 API) ---
# All five required for uploads; omit any to disable attachment uploads (503 from upload routes).
# S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=eu-central-1
# S3_JOBS_PREFIX=job-attachments
# HTTPS base where objects are publicly readable (no trailing slash): GET {S3_PUBLIC_BASE_URL}/{key}
# S3_PUBLIC_BASE_URL=https://your-bucket.example.com
